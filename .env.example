# Copy to .env and adjust as needed. .env is git-ignored.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_DB=threadims
POSTGRES_USER=threadims
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# pgAdmin (optional service)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme
PGADMIN_PORT=5050

# JWT signing secret (HS256, 32+ bytes). The backend has a dev-only default
# under the "dev" profile; this MUST be set explicitly in production.
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
